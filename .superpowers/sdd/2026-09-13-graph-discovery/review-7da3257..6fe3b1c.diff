+      const hit = store.get(k);
+      return hit ? new Response(hit.body, { status: hit.status, headers: hit.headers }) : undefined;
+    },
+    async put(key: Request | string, value: Response) {
+      store.set(typeof key === "string" ? key : key.url, value);
+    },
+  },
+} as never;
