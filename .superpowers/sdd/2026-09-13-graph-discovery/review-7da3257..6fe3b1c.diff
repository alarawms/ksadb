+            if (sql.includes("JOIN taxonomy t"))
+              return { results: [{ genus: "Homo", family: "Hominidae", phylum: "Chordata" }] };
+            return { results: [] };
+          };
+          return { bind: () => ({ all, first: async () => (await all()).results[0] ?? null }) };
+        },
+      },
+    },
